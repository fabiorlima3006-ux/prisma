# Token da brapi.dev (https://brapi.dev). Opcional: sem ele, os ativos usam dados demonstrativos.
# Guarde o valor real apenas em .env.local (fora do git).
BRAPI_TOKEN=

# URL base da API do Banco Central. Opcional; o padrão é https://api.bcb.gov.br.
BCB_BASE_URL=

# URL pública do site, usada em metadados e links absolutos. Opcional; o padrão é http://localhost:3000.
NEXT_PUBLIC_SITE_URL=
